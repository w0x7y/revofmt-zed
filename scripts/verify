#!/usr/bin/env bash
set -euo pipefail
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"
python3 tests/run.py "$@"
if (( $# )); then exit 0; fi
npm test
cargo fmt --check
cargo test --locked
cargo clippy --all-targets --locked -- -D warnings
scripts/package-server --check
