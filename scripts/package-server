#!/usr/bin/env python3
"""Build the versioned server asset, or check its Rust digest manifest."""
import argparse
import gzip
import hashlib
import io
from pathlib import Path
import tarfile
import tomllib

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--update-checksums', action='store_true')
parser.add_argument('--check', action='store_true', help='check digests without writing an archive')
args = parser.parse_args()
if args.check and args.update_checksums:
    parser.error('--check and --update-checksums are mutually exclusive')
manifest = tomllib.loads((root / 'extension.toml').read_text())
version = manifest['version']
files = sorted((root / 'server').glob('*.cjs'))
if not files or not (root / 'server/main.cjs').is_file():
    raise SystemExit('missing server/main.cjs')
entries = []
for path in files:
    if path.is_symlink() or not path.is_file():
        raise SystemExit(f'not a regular runtime file: {path}')
    entries.append((path.relative_to(root).as_posix(), path.read_bytes()))
checksums = '// Generated by scripts/package-server --update-checksums.\n'
checksums += 'pub const SERVER_FILES: &[(&str, &str)] = &[\n'
for name, data in entries:
    checksums += f'    ("{name}", "{hashlib.sha256(data).hexdigest()}"),\n'
checksums += '];\n'
# Match cargo fmt so regenerating does not cause unrelated whitespace churn.
checksums = checksums.replace('    ("', '    (\n        "').replace('", "', '",\n        "').replace('"),\n', '",\n    ),\n')
checksum_path = root / 'src/server_checksums.rs'
if args.update_checksums:
    checksum_path.write_text(checksums)
elif checksum_path.read_text() != checksums:
    raise SystemExit('runtime digests are stale; run scripts/package-server --update-checksums')
if args.check:
    print(f'Checked {len(entries)} runtime digests for {version}')
    raise SystemExit(0)
entries.append(('LICENSE', (root / 'LICENSE').read_bytes()))
output = root / 'dist' / f'revofmt-lsp-{version}.tar.gz'
output.parent.mkdir(exist_ok=True)
with output.open('wb') as raw:
    with gzip.GzipFile(filename='', mode='wb', fileobj=raw, mtime=0) as zipped:
        with tarfile.open(fileobj=zipped, mode='w', format=tarfile.USTAR_FORMAT) as archive:
            for name, data in entries:
                info = tarfile.TarInfo(name)
                info.size = len(data)
                info.mode = 0o644
                info.mtime = 0
                archive.addfile(info, io.BytesIO(data))
print(f'{hashlib.sha256(output.read_bytes()).hexdigest()}  {output}')
